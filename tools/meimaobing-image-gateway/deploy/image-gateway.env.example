# Stored outside Git at $BETA_SECRETS_DIR/image-gateway.env with mode 0600.
# OpenTu static app and this gateway share this exact public origin.
# Fill in the real environment hostnames; example.test is not a product URL.
MEIMAOBING_IMAGE_GATEWAY_PUBLIC_ORIGIN=https://image.example.test
MEIMAOBING_IMAGE_GATEWAY_COOKIE_SECURE=true
MEIMAOBING_IMAGE_GATEWAY_OIDC_ISSUER=https://auth.example.test
MEIMAOBING_IMAGE_GATEWAY_OIDC_CLIENT_ID=meimaobing-image-gateway
MEIMAOBING_IMAGE_GATEWAY_OIDC_CLIENT_SECRET=
MEIMAOBING_IMAGE_GATEWAY_SESSION_SECRET=
# Must exactly match INFERENCE_BROKER_IMAGE_PRINCIPAL_HMAC_SECRET in
# $BETA_SECRETS_DIR/inference-broker.env. Never generate it independently.
MEIMAOBING_IMAGE_GATEWAY_PRINCIPAL_HMAC_SECRET=

# Private Beta-only account-center auth-epoch verifier. It must match only the
# Image-specific value in beta-better-auth-center.env, never an OAuth/session
# or broker principal secret. This URL is Docker-internal and not browser-safe.
MEIMAOBING_IMAGE_GATEWAY_AUTH_EPOCH_VERIFIER_URL=http://beta-better-auth-center:8080/internal/v1/principal-sessions
MEIMAOBING_IMAGE_GATEWAY_AUTH_EPOCH_VERIFIER_PRODUCT=image
MEIMAOBING_IMAGE_GATEWAY_AUTH_EPOCH_VERIFIER_SECRET=

# Private Docker-network destination only; never use a public TokenHub URL.
MEIMAOBING_IMAGE_GATEWAY_BROKER_BASE_URL=http://inference-broker:8080
MEIMAOBING_IMAGE_GATEWAY_ENABLED=false
# Application Wallet prepaid balance is shared by Image, Chat and Agent.
# Compose must set MEIMAOBING_IMAGE_GATEWAY_STORE_INGRESS_PROFILE for the
# environment you are deploying.
MEIMAOBING_IMAGE_GATEWAY_TOP_UP_URL=https://store.example.test/user/recharge/index
MEIMAOBING_IMAGE_GATEWAY_MODELS=gemini-3.1-flash-lite-image,gemini-3.1-flash-image,gemini-3-pro-image,gemini-2.5-flash-image,gpt-image-2,codex-gpt-image-2
MEIMAOBING_IMAGE_GATEWAY_MAX_BODY_BYTES=26214400
MEIMAOBING_IMAGE_GATEWAY_SESSION_TTL_SECONDS=28800
