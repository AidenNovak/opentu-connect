# Public, same-origin address of the static app and this gateway. HTTPS is
# required outside local development because the gateway uses HttpOnly cookies.
MEIMAOBING_IMAGE_GATEWAY_PUBLIC_ORIGIN=http://localhost:7200
MEIMAOBING_IMAGE_GATEWAY_COOKIE_SECURE=false

# Dedicated Truthtruth Beta OIDC client. Register this exact callback URL:
# ${MEIMAOBING_IMAGE_GATEWAY_PUBLIC_ORIGIN}/auth/meimaobing/callback
MEIMAOBING_IMAGE_GATEWAY_OIDC_ISSUER=https://auth.truthtruth.co
MEIMAOBING_IMAGE_GATEWAY_OIDC_CLIENT_ID=
MEIMAOBING_IMAGE_GATEWAY_OIDC_CLIENT_SECRET=

# Beta account-center auth-epoch verifier. These values stay server-side and
# must use the private Docker account-center endpoint.
MEIMAOBING_IMAGE_GATEWAY_AUTH_EPOCH_VERIFIER_URL=http://beta-better-auth-center:8080/internal/v1/principal-sessions
MEIMAOBING_IMAGE_GATEWAY_AUTH_EPOCH_VERIFIER_PRODUCT=image
MEIMAOBING_IMAGE_GATEWAY_AUTH_EPOCH_VERIFIER_SECRET=

# Generate a session secret of at least 32 characters. The principal secret
# must exactly match INFERENCE_BROKER_IMAGE_PRINCIPAL_HMAC_SECRET in the
# private Beta Broker secret file; do not generate a second copy.
# Keep both only in the gateway process; do not prefix them with VITE_.
MEIMAOBING_IMAGE_GATEWAY_SESSION_SECRET=
MEIMAOBING_IMAGE_GATEWAY_PRINCIPAL_HMAC_SECRET=

# Private beta Inference Broker origin. The broker, not this process, resolves
# the subject-owned TokenHub key and Application Wallet reservation.
MEIMAOBING_IMAGE_GATEWAY_BROKER_BASE_URL=http://inference-broker:8080

# Closed by default. Set true only after the Beta Broker/TokenHub image
# surface, reservation quote, and reconciliation paths are deployed together.
MEIMAOBING_IMAGE_GATEWAY_ENABLED=false

# Optional UI and runtime settings.
# The Beta Application Wallet is funded by its prepaid recharge page; it is
# not the legacy card store or monthly-subscription path.
MEIMAOBING_IMAGE_GATEWAY_TOP_UP_URL=https://store.truthtruth.co/user/recharge/index
MEIMAOBING_IMAGE_GATEWAY_MODELS=gemini-3.1-flash-lite-image,gemini-3.1-flash-image,gemini-3-pro-image,gemini-2.5-flash-image,gpt-image-2,codex-gpt-image-2
MEIMAOBING_IMAGE_GATEWAY_MAX_BODY_BYTES=26214400
MEIMAOBING_IMAGE_GATEWAY_SESSION_TTL_SECONDS=28800
PORT=8787
